# Good Car Imports — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.

# ─── Application ──────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Database (MariaDB) ───────────────────────────────────────
DATABASE_URL="mysql://gci_user:gci_password@localhost:3306/good_car_imports?connection_limit=20&pool_timeout=10"

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Authentication ───────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET="REPLACE_WITH_64_BYTE_RANDOM_SECRET"
JWT_COOKIE_NAME="gci_session"
JWT_EXPIRY="24h"

# ─── Image Pipeline ───────────────────────────────────────────
UPLOAD_DIR="./public/uploads"
UPLOAD_URL_PREFIX="/uploads"
MAX_UPLOAD_SIZE_BYTES=10485760    # 10 MB
WORKER_CONCURRENCY=2              # sharp concurrency — protect RAM

# ─── Gmail SMTP ───────────────────────────────────────────────
# Use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="REPLACE_WITH_GMAIL_ADDRESS"
SMTP_PASS="REPLACE_WITH_APP_PASSWORD"
SMTP_FROM_NAME="Good Car Imports"
SMTP_FROM_EMAIL="REPLACE_WITH_GMAIL_ADDRESS"
SMTP_ADMIN_EMAIL="goodcarimports.bd@gmail.com"

# ─── Forex API ────────────────────────────────────────────────
FOREX_API_URL="https://api.exchangerate-api.com/v4/latest/JPY"
FOREX_CACHE_SECONDS=3600

# ─── BullMQ / Worker ──────────────────────────────────────────
BULL_IMAGE_QUEUE="image-processing"

# ─── ISR Revalidation ─────────────────────────────────────────
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET="REPLACE_WITH_32_BYTE_RANDOM_HEX"

# ─── IndexNow ─────────────────────────────────────────────────
INDEXNOW_KEY="REPLACE_WITH_INDEXNOW_KEY"

# ─── Sentry Error Monitoring ──────────────────────────────────
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ─── Google Analytics ─────────────────────────────────────────
NEXT_PUBLIC_GA4_ID=""

# ─── Company Info (used for JSON-LD, llms.txt, etc.) ──────────
NEXT_PUBLIC_COMPANY_NAME="Good Car Imports"
NEXT_PUBLIC_COMPANY_PHONE="+8801992424492"
NEXT_PUBLIC_COMPANY_EMAIL="goodcarimports.bd@gmail.com"
NEXT_PUBLIC_COMPANY_ADDRESS="56 Inner Circular Road, Eastern Trade Center (6 Floor), Purana Paltan Line, Dhaka-1000, Bangladesh"
NEXT_PUBLIC_COMPANY_LAT="23.7337"
NEXT_PUBLIC_COMPANY_LNG="90.4131"
NEXT_PUBLIC_WHATSAPP_NUMBER="8801992424492"
