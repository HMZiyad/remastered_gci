{
  "name": "remastered-good-car-imports",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "ts-node --project tsconfig.seed.json prisma/seed.ts",
    "worker": "ts-node --project tsconfig.worker.json src/workers/image-worker.ts",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --grep @visual"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^8.55.2",
    "bcryptjs": "^3.0.3",
    "blurhash": "^2.0.5",
    "browser-image-compression": "^2.0.2",
    "bullmq": "^5.81.5",
    "file-type": "^19.6.0",
    "ioredis": "^5.11.1",
    "iron-session": "^9.0.1",
    "jose": "^5.10.0",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "nodemailer": "^6.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.33.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sharp": "^0.31.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "prisma": "^6.8.0",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
